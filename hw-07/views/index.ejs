<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <title>Todo</title>
  </head>
  <body>
    <h1>Todo seznam</h1>

    <form action="/add" method="POST">
      <input type="text" name="title" placeholder="Novy ukol" required />
      <button type="submit">Pridat</button>
    </form>

    <ul id="todo-list">
      <% todos.forEach(function (todo) { %>
        <li>
          <a href="/todo/<%= todo.id %>"><%= todo.title %></a>
          [priorita: <%= todo.priority %>]
          <%= todo.done ? "(hotovo)" : "(nehotovo)" %>
        </li>
      <% }); %>
    </ul>
  <script>
    var ws = new WebSocket('ws://' + window.location.host + '/ws/todos');
    ws.onmessage = function (event) {
    var todos = JSON.parse(event.data);
    var html = "";
    todos.forEach(function (todo) {
      html += "<li>";
      html += '<a href="/todo/' + todo.id + '">' + todo.title + "</a> ";
      html += "[priorita: " + todo.priority + "] ";
      html += todo.done ? "(hotovo)" : "(nehotovo)";
      html += "</li>";
    });
    document.getElementById("todo-list").innerHTML = html;
  };
  </script>
  </body>
</html>

